{
  "buildCommand": "node scripts/build-races.js",
  "outputDirectory": "public",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "isard.app" }],
      "destination": "https://www.isard.app/:path*",
      "permanent": true
    },
    { "source": "/", "destination": "https://www.isard.app/es/", "permanent": true },
    { "source": "/race-calendar", "destination": "https://www.isard.app/es/race-calendar", "permanent": true },
    { "source": "/races/:slug*", "destination": "https://www.isard.app/es/races/:slug*", "permanent": true }
  ]
}
